# ~/.zshrc
#
# Shared across machines. Anything private, host-specific, or path-dependent
# belongs in ~/.zshrc.local (sourced at the very end, never tracked).
#
# Optional tools are guarded with `(( $+commands[x] ))` so this file stays safe
# on a machine where a given tool isn't installed yet.

# ------------------------------------------------------------------------------
# CACHED INIT HELPER
# ------------------------------------------------------------------------------
# Regenerates the cache when the tool's binary is newer than it. Returns early
# if the tool isn't installed, so a partially-provisioned machine still boots.
_cached_init() {
  (( $+commands[$1] )) || return
  local cache="$HOME/.cache/zsh-init-$1.zsh"
  [[ -f "$cache" && ! "${commands[$1]}" -nt "$cache" ]] || "$@" > "$cache"
  source "$cache"
}

# ------------------------------------------------------------------------------
# PROMPT
# ------------------------------------------------------------------------------
# Prefers oh-my-posh, falls back to starship. Without the fallback a machine
# that has only one of the two ends up with no prompt at all.
_omp_config="$HOME/.config/oh-my-posh/atomic.omp.json"
if (( $+commands[oh-my-posh] )) && [[ -f "$_omp_config" ]]; then
  _omp_cache="$HOME/.cache/oh-my-posh-init.zsh"
  if [[ ! -f "$_omp_cache" || "$_omp_config" -nt "$_omp_cache" || "${commands[oh-my-posh]}" -nt "$_omp_cache" ]]; then
    oh-my-posh init zsh --config "$_omp_config" > "$_omp_cache"
  fi
  source "$_omp_cache"
else
  _cached_init starship init zsh
fi
unset _omp_config

# ------------------------------------------------------------------------------
# HISTORY
# ------------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_SPACE
setopt EXTENDED_HISTORY      # record command timestamps
setopt HIST_VERIFY           # expand history (!!) onto the line before running
setopt HIST_FIND_NO_DUPS     # skip dupes when cycling through history search

# ------------------------------------------------------------------------------
# ZSH OPTIONS
# ------------------------------------------------------------------------------
setopt AUTO_CD
# CORRECT deliberately left off: it prompts "correct 'rails' to 'rail'?" on
# perfectly valid commands, and false positives are common with per-project
# binaries and git subcommands.
setopt INTERACTIVE_COMMENTS
setopt AUTO_PUSHD            # cd pushes onto the dir stack
setopt PUSHD_IGNORE_DUPS     # no duplicate entries on the stack
setopt PUSHD_SILENT          # don't print the stack after pushd/popd

# ------------------------------------------------------------------------------
# ENVIRONMENT
# ------------------------------------------------------------------------------
export EDITOR="nvim"
export VISUAL="nvim"

# This Neovim config is loaded under the `lazyvim` app-name: config comes from
# ~/.config/lazyvim and data (including Mason packages) from
# ~/.local/share/lazyvim. Without this, plain `nvim` uses ~/.local/share/nvim
# and finds none of the Mason-installed language servers.
export NVIM_APPNAME="lazyvim"

# Ruby/Elixir toolchains are noticeably happier with an explicit UTF-8 locale.
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Persist IEx/erl shell history across sessions.
export ERL_AFLAGS="-kernel shell_history enabled"

export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
export GOPATH=$HOME/go-workspace
export CLAUDE_CODE_NO_FLICKER=1
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export LDFLAGS="-L/opt/homebrew/opt/llvm/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include"

# FZF
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height=40% --layout=reverse --border'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons {}'"

# PATH (typeset -U deduplicates)
typeset -U path
path=(
  "$GOPATH/bin"
  "$HOME/bin"
  "$HOME/.local/bin"
  "/opt/homebrew/opt/libpq/bin"
  "$HOME/.antigravity/antigravity/bin"
  $path
  # Appended, NOT prepended, so project binstubs and `bundle exec` always win.
  # Puts Neovim's Mason-managed tools (ruby-lsp, rubocop, prettier, eslint_d,
  # erb-format, shellcheck, shfmt, stylua) on the shell PATH at the exact
  # versions the editor uses.
  "$HOME/.local/share/lazyvim/mason/bin"
)
export PATH

# ------------------------------------------------------------------------------
# ALIASES
# ------------------------------------------------------------------------------
# Navigation. The workspace lives in a different place on each machine, so it's
# a variable with a sane default — override WORKSPACE in ~/.zshrc.local
# (e.g. when it lives on an external volume).
: ${WORKSPACE:="$HOME/workspace"}
alias wks='cd "$WORKSPACE"'

# Docker
alias dc='docker compose'
alias dps='docker compose ps'
alias dl='docker logs -f'
alias dex='docker exec -it'
alias dstat='docker stats --no-stream'
alias docker-clean='docker system prune -af --volumes'

# Git
alias g='git'
alias ga='git add'
alias gc='git commit'
alias gs='git status'
alias gco='git checkout'
alias gl='git log --oneline --graph --decorate'
alias lg='lazygit'

# Rails
alias be='bundle exec'
alias rc='bin/rails console'
alias rs='bin/rails server'
alias rdm='bin/rails db:migrate'
alias rt='bin/rails test'

# Elixir / Phoenix
alias mps='mix phx.server'
alias mdg='mix deps.get'
alias mt='mix test'
alias iexs='iex -S mix'

# Search
alias rg='rg --smart-case'
alias grep='rg --smart-case'

# Modern replacements
alias ls='eza --icons --group-directories-first'
alias ll='eza -la --icons --group-directories-first --git'
alias tree='eza --tree --icons'
# `-n` shows line numbers; do NOT add `--plain`, which cancels it out.
# `--paging=never` keeps redirects and pipes clean.
alias cat='bat -n --paging=never'
alias less='bat --paging=always'

# ------------------------------------------------------------------------------
# FUNCTIONS
# ------------------------------------------------------------------------------
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# Lazy conda init — the hook is slow, so it only runs on the first `conda` call
if [[ -d /opt/homebrew/Caskroom/miniforge/base ]]; then
  conda() {
    unfunction conda
    local setup
    if setup="$('/opt/homebrew/Caskroom/miniforge/base/bin/conda' 'shell.zsh' 'hook' 2>/dev/null)"; then
      eval "$setup"
    elif [[ -f /opt/homebrew/Caskroom/miniforge/base/etc/profile.d/conda.sh ]]; then
      . /opt/homebrew/Caskroom/miniforge/base/etc/profile.d/conda.sh
    else
      path=("/opt/homebrew/Caskroom/miniforge/base/bin" $path)
    fi
    conda "$@"
  }
fi

# ------------------------------------------------------------------------------
# ZSH COMPLETIONS (cached — rebuilds once every 24h)
# ------------------------------------------------------------------------------
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
  touch ~/.zcompdump    # compinit only rewrites the dump on changes; reset the 24h clock ourselves
else
  compinit -C
fi

# Completion styling
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'l:|=* r:|=*'  # case-insensitive + partial
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}%d%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zcompcache"

# ------------------------------------------------------------------------------
# TOOL INITIALIZATIONS
# ------------------------------------------------------------------------------
# FZF
_cached_init fzf --zsh

# Zsh plugins
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null

_autosuggest_or_complete() {
  if [[ -n "$POSTDISPLAY" ]]; then
    zle autosuggest-accept
  else
    zle expand-or-complete
  fi
}
zle -N _autosuggest_or_complete
bindkey '\t' _autosuggest_or_complete

source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null

# Direnv
_cached_init direnv hook zsh

# Zoxide
_cached_init zoxide init zsh

# Atuin — replaces ctrl-r with a far better history search. Up-arrow is left
# alone so it keeps doing prefix search / autosuggestions.
_cached_init atuin init zsh --disable-up-arrow

# Mise (cached for faster startup) — should be last
_mise_cache="$HOME/.cache/mise-activate.zsh"
if [[ -x "$HOME/.local/bin/mise" ]]; then
  if [[ ! -f "$_mise_cache" || "$HOME/.local/bin/mise" -nt "$_mise_cache" ]]; then
    "$HOME/.local/bin/mise" activate zsh > "$_mise_cache"
  fi
  source "$_mise_cache"
fi

# ------------------------------------------------------------------------------
# TERMINAL INTEGRATIONS
# ------------------------------------------------------------------------------
[[ "$TERM_PROGRAM" == "ghostty" ]] && export TERM=xterm-256color
[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"
[[ -f "$HOME/.iterm2_shell_integration.zsh" ]] && source "$HOME/.iterm2_shell_integration.zsh"

# ------------------------------------------------------------------------------
# LOCAL OVERRIDES (secrets, machine-specific config — not tracked)
# ------------------------------------------------------------------------------
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
