+function windowKey(window) {
+  return window && window.address ? String(window.address).replace(/^0x/, "") : ""
+}
+
+function indexOfWindow(values, window) {
+  if (!window) return -1
+  var key = windowKey(window)
+  for (var i = 0; i < values.length; i++) {
+    if (values[i] === window || (key && windowKey(values[i]) === key)) return i
+  }
+  return -1
+}
+
+// Seed the list once, then retain its order across focus changes. New windows
+// join the end and closed windows leave without reshuffling the survivors.
+function stableWindows(values, previous) {
+  var live = values ? Array.prototype.slice.call(values) : []
+  if (!previous || previous.length === 0) return sortedWindows(live)
+  var result = []
+  for (var i = 0; i < previous.length; i++) {
+    var liveIndex = indexOfWindow(live, previous[i])
+    if (liveIndex >= 0) result.push(live[liveIndex])
+  }
+  for (var j = 0; j < live.length; j++) {
+    if (indexOfWindow(result, live[j]) < 0) result.push(live[j])
+  }
+  return result
+}
+
+function cycleIndex(values, current, direction) {
+  if (values.length === 0) return 0
+  var index = indexOfWindow(values, current)
+  if (index < 0) {
+    for (var i = 0; i < values.length; i++) {
+      if (isCurrent(values[i])) { index = i; break }
+    }
+  }
+  if (index < 0) return direction < 0 ? values.length - 1 : 0
+  return (index + (direction < 0 ? -1 : 1) + values.length) % values.length
+}
