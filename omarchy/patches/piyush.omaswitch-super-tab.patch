diff --git a/test_model.js b/test_model.js
index 90df33a..ac412c0 100644
--- a/test_model.js
+++ b/test_model.js
@@ -59,3 +59,38 @@ assert.equal(Model.isCurrent(staleEmpty), false, "empty focusHistoryID must not
 assert.equal(Model.isCurrent({ activated: false, lastIpcObject: {} }), false, "missing focusHistoryID must not be current")
 assert.equal(Model.isCurrent(editorCur), true, "activated window must be current")
 assert.equal(Model.isCurrent({ activated: false, lastIpcObject: { focusHistoryID: 0 } }), true, "real rank 0 must be current")
+
+// Full forward and reverse cycles retain the same order after focus changes.
+const ringA = { address: "aaa", title: "A", lastIpcObject: { focusHistoryID: 0 } }
+const ringB = { address: "bbb", title: "B", lastIpcObject: { focusHistoryID: 1 } }
+const ringC = { address: "ccc", title: "C", lastIpcObject: { focusHistoryID: 2 } }
+let ring = Model.stableWindows([ringC, ringA, ringB], [])
+assert.deepEqual(ring, [ringA, ringB, ringC])
+let current = ringA
+for (const expectedWindow of [ringB, ringC, ringA, ringB]) {
+  const next = ring[Model.cycleIndex(ring, current, 1)]
+  assert.equal(next, expectedWindow, "each tap must visit the next window, including wraparound")
+  ringA.lastIpcObject.focusHistoryID = next === ringA ? 0 : 2
+  ringB.lastIpcObject.focusHistoryID = next === ringB ? 0 : 1
+  ringC.lastIpcObject.focusHistoryID = next === ringC ? 0 : 2
+  ring = Model.stableWindows([next, ringC, ringA, ringB].filter((w, i, a) => a.indexOf(w) === i), ring)
+  assert.deepEqual(ring, [ringA, ringB, ringC], "focus must not reorder the list")
+  current = next
+}
+assert.equal(Model.cycleIndex(ring, ringA, -1), 2, "reverse wraps from first to last")
+assert.equal(Model.cycleIndex([], null, 1), 0)
+assert.equal(Model.cycleIndex([ringA], ringA, 1), 0)
+assert.equal(Model.cycleIndex([ringA], ringA, -1), 0)
+
+// A queued focus target wins over the still-current window during quick taps.
+ringA.lastIpcObject.focusHistoryID = 0
+assert.equal(Model.cycleIndex(ring, ringB, 1), 2, "pending B focus must make the next tap select C")
+
+// Closed windows leave, new ones append, and recreated wrappers retain identity.
+const ringD = { address: "ddd", title: "D", lastIpcObject: { focusHistoryID: 0 } }
+const newWrapperC = { address: "0xccc", title: "Renamed C" }
+assert.deepEqual(Model.stableWindows([ringD, newWrapperC, ringA], ring), [ringA, newWrapperC, ringD])
+assert.equal(Model.indexOfWindow([newWrapperC], ringC), 0)
+assert.equal(Model.indexOfWindow(ring, null), -1)
+assert.equal(Model.focusRequest({ address: "0xaaa" }), "hl.dsp.focus({ window = 'address:0xaaa' })")
+console.log("Round-robin, wraparound, and rapid-tap checks passed")
