diff --git a/tests/barui-test.sh b/tests/barui-test.sh
new file mode 100644
--- /dev/null
+++ b/tests/barui-test.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+set -euo pipefail
+
+ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+SOURCE=${1:-$ROOT}
+SHELL_DIR="${OMARCHY_PATH:-/usr/share/omarchy}/shell"
+
+if ! command -v quickshell >/dev/null 2>&1 || [[ ! -d $SHELL_DIR/Commons ]]; then
+  printf 'barui-test: skipped (Quickshell or Omarchy imports unavailable)\n'
+  exit 0
+fi
+
+TMP=$(mktemp -d)
+trap 'rm -rf -- "$TMP"' EXIT
+mkdir "$TMP/Plugin"
+cp "$SOURCE"/{BarWorkbench,BarRail,ItemData,TechFrame}.qml "$TMP/Plugin/"
+ln -s "$SHELL_DIR/Commons" "$TMP/Commons"
+cp "$ROOT/tests/barui.qml" "$TMP/shell.qml"
+if ! output=$(QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software timeout 20 quickshell --no-color -p "$TMP" 2>&1); then
+  printf '%s\n' "$output" >&2
+  exit 1
+fi
+if [[ $output != *"barui-test: ok"* || $output == *"TypeError:"* || $output == *"ReferenceError:"* || $output == *"ERROR qml:"* ]]; then
+  printf '%s\n' "$output" >&2
+  exit 1
+fi
+printf 'barui-test: ok\n'
