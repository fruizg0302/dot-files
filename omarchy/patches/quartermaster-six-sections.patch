+    layout: root.fixtureLayout || ({})
+  }
+
+  function check(condition, message) {
+    if (!condition) throw new Error(message)
+  }
+
+  function checkRail() {
+    var groups = Array.from(rail.children).filter(function(child) { return child.ids !== undefined })
+    var ids = []
+    for (var i = 0; i < groups.length; i++) ids = ids.concat(groups[i].ids)
+    check(ids.join(",") === "left,before,clock,after,right", "rail omits a visible section or exposes drawer contents")
+    var middle = groups.filter(function(group) { return group.ids[0] === "clock" })[0]
+    check(Math.abs(middle.x + middle.width / 2 - rail.width / 2) < 1, "clock is not centered horizontally")
+    check(Math.abs(middle.y + middle.height / 2 - rail.height / 2) < 1, "clock is not centered vertically")
+  }
+
+  Component.onCompleted: {
+    workbench.host = root.fixtureHost
+    Qt.callLater(function() {
+    try {
+      check(workbench.bins.map(function(bin) { return bin.id }).join(",")
+        === "left,centerBegin,center,centerEnd,right,tray", "workbench omits a bar section")
+      check(workbench.benchIds.join(",") === "off", "active widgets are incorrectly benched")
+      check(workbench.whereIs("hidden").zone === "tray", "hidden widget is not in the tray bin")
+      checkRail()
+      rail.horizontal = false
+      rail.width = 50
+      rail.height = 1000
+      Qt.callLater(function() {
+        try {
+          checkRail()
+          console.log("barui-test: ok")
+          Qt.exit(0)
+        } catch (error) {
+          console.error(error.message)
+          Qt.exit(1)
+        }
+      })
+    } catch (error) {
+      console.error(error.message)
+      Qt.exit(1)
+    }
+    })
+  }
