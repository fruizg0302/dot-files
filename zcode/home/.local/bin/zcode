#!/bin/sh
# ZCode CLI built from source (zai-org/ZCode @ 0.16.9).
# The desktop AppImage build does not ship @zcode/tui, so bare `zcode` (TUI) is
# served by this build instead. Old launcher saved as zcode.appimage-launcher.bak.
set -e
# Node 26's FFI backend cannot initialize this build's OpenTUI renderer.
exec "$HOME/.local/share/mise/installs/node/22.23.5/bin/node" "$HOME/src/ZCode/apps/zcode-cli/packages/cli/dist/zcode.cjs" "$@"
